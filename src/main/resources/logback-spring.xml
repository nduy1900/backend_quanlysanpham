<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Ghi log ra file và tự động xoay vòng theo ngày -->
    <appender name="ROLLING_FILE"
              class="ch.qos.logback.core.rolling.RollingFileAppender">

        <!-- File log hiện tại -->
        <file>logs/application.log</file>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} %-5level [%thread] %logger{36} - %msg%n
            </pattern>
        </encoder>

        <!-- Cấu hình xoay vòng theo ngày -->
        <rollingPolicy
                class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">

            <!-- Tên file log được lưu theo ngày -->
            <fileNamePattern>
                logs/application.%d{yyyy-MM-dd}.log
            </fileNamePattern>

            <!-- Giữ log trong 30 ngày -->
            <maxHistory>30</maxHistory>

        </rollingPolicy>

    </appender>

    <!-- Ghi log ra Console -->
    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n
            </pattern>
        </encoder>

    </appender>

    <!-- Liên kết các Appender với Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="ROLLING_FILE"/>
    </root>

</configuration>